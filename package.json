{
  "name": "busmadrid",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "formatear": "eslint . --fix",
    "comprobar-tipos": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verificar": "npm run comprobar-tipos && npm run lint && npm test"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.prueba.{ts,tsx}",
      "**/?(*.)+(spec|test).{ts,tsx}"
    ]
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bottom-tabs": "^1.3.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
