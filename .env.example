# Credenciales de la API de EMT Madrid (MobilityLabs).
# Copia este archivo a ".env" y rellena UNA de las dos opciones.
#
# OPCIÓN A (recomendada) — "Protected": registra tu app en el portal
# https://mobilitylabs.emtmadrid.es y copia aquí el X-ClientId y el passKey.
# No expone tu contraseña personal y la sesión dura más.
EXPO_PUBLIC_EMT_CLIENT_ID=
EXPO_PUBLIC_EMT_PASSKEY=

# OPCIÓN B — "Basic": tu cuenta del portal (25.000 peticiones/día).
# Úsala solo si aún no has registrado la app. Si rellenas la opción A, esta se ignora.
EXPO_PUBLIC_EMT_EMAIL=
EXPO_PUBLIC_EMT_PASSWORD=

# Opcional: si montas un proxy propio, apunta aquí su base (con https).
# Si se define, la app llamará al proxy en vez de a openapi.emtmadrid.es directamente
# y las credenciales se quedan en el servidor (lo ideal para publicar).
# EXPO_PUBLIC_EMT_PROXY_BASE=https://tu-proxy.example.com
