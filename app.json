{
  "expo": {
    "name": "AccessBus",
    "slug": "busmadrid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f67fc9b8-044e-47ff-a2fe-db72b4c84fc4",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1626"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jmortizsilva.busmadrid",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1626"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-bottom-tabs",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AccessBus usa tu ubicación para mostrarte las paradas de autobús más cercanas."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f67fc9b8-044e-47ff-a2fe-db72b4c84fc4"
      }
    },
    "owner": "jmortizsilva"
  }
}
